# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
# BR2_PACKAGE_LVM2_STANDARD_INSTALL is not set
# BR2_PACKAGE_NFS_UTILS_RPC_NFSD is not set
# BR2_PACKAGE_SYSTEMD_HWDB is not set
BR2_PACKAGE_SYSTEMD_NETWORKD=y
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_RAUC_DBUS=y
BR2_PACKAGE_RAUC_NETWORK=y
BR2_PACKAGE_SYSTEMD=y
BR2_CCACHE=y
BR2_CCACHE_DIR="/cache/cc"
BR2_DL_DIR="/cache/dl"
BR2_ENABLE_LTO=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# BR2_GLOBAL_PATCH_DIR is not set
BR2_INIT_SYSTEMD=y
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/jethome-iot/linux-kernel.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="linux-s7-5.15"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_JHOS_PATH)/board/jethome/kernel-amlogic.config"
BR2_KERNEL_HEADERS_5_15=y
BR2_LINUX_KERNEL_IMAGE_TARGET_CUSTOM=y
BR2_LINUX_KERNEL_IMAGE_TARGET_NAME="Image meson-s7-jethub-j310.dtb"
BR2_LINUX_KERNEL_IMAGE_NAME="Image"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_JHOS_PATH)/busybox.config"
BR2_PACKAGE_BUSYBOX_INDIVIDUAL_BINARIES=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_RAUC=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y
BR2_PACKAGE_UBOOT_TOOLS=y
BR2_PACKAGE_UBOOT_TOOLS_FWPRINTENV=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y
BR2_PACKAGE_WIRELESS_REGDB=y
# BR2_PACKAGE_WPA_SUPPLICANT is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_JHOS_PATH)/rootfs-overlay $(BR2_EXTERNAL_JHOS_PATH)/board/jethome/jethub-j310/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_JHOS_PATH)/scripts/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_JHOS_PATH)/scripts/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="$(BR2_EXTERNAL_JHOS_PATH)/board/jethome/jethub-j310 $(BR2_EXTERNAL_JHOS_PATH)/board/jethome/jethub-j310/os-hook.sh"
BR2_SSP_REGULAR=y
BR2_SYSTEM_BIN_SH_BASH=y
BR2_TARGET_GENERIC_HOSTNAME="jethubj310"
BR2_TARGET_GENERIC_ISSUE="Welcome to JetHub"
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_LZMA=y
# BR2_TARGET_UBOOT is not set
BR2_aarch64=y
# BR2_PACKAGE_LINUX_PAM is not set
BR2_PACKAGE_LIBXCRYPT=y
BR2_PER_PACKAGE_DIRECTORIES=y
BR2_GNU_MIRROR="https://mirror.truenetwork.ru/gnu/"
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_LOSETUP=y
# jrescue-app selects its own runtime deps (python3+curses/ssl/xz/zlib,
# Pillow+freetype+dejavu, evdev, ncurses, pv) via package/jrescue-app/Config.in
BR2_PACKAGE_JRESCUE_APP=y
BR2_ENABLE_LOCALE=y
BR2_GENERATE_LOCALE="C.UTF-8 ru_RU.UTF-8"
