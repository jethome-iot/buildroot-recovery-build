# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DISTRO_DEFAULTS=y
# CONFIG_EXPERT is not set
# CONFIG_DISPLAY_CPUINFO is not set
# CONFIG_DISPLAY_BOARDINFO is not set
CONFIG_BOOTDELAY=3
CONFIG_SYS_PROMPT="JHOS> "
# CONFIG_ISO_PARTITION is not set
CONFIG_EFI_PARTITION=y
CONFIG_FS_EXT4=y
CONFIG_FS_FAT=y
CONFIG_FAT_WRITE=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_EXT4 is not set
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_EFI_LOADER is not set
# CONFIG_DFU is not set
# CONFIG_CMD_DFU is not set
# CONFIG_TOOLS_MKEFICAPSULE is not set
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_FILEENV=y
CONFIG_FS_EROFS=y
CONFIG_CMD_EROFS=y
CONFIG_FS_EROFS_ZIP=y
CONFIG_FS_EROFS_ZIP_DEFLATE=y
CONFIG_LZ4=y
CONFIG_LZO=y
CONFIG_LZMA=y
CONFIG_CMD_LZMADEC=y
CONFIG_ZSTD=y
CONFIG_CMD_LZMADEC=y
CONFIG_CMD_UNLZ4=y
CONFIG_CMD_UNZIP=y
CONFIG_CMD_ZIP=y
CONFIG_MTD=y
CONFIG_CMD_SF=y
CONFIG_SPI_FLASH_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_PARTITIONS=y
CONFIG_CMD_MTDPARTS=y
CONFIG_MTDIDS_DEFAULT="nor0=spi0.0"
CONFIG_MTDPARTS_DEFAULT="mtdparts=spi0.0:2M(uboot),64k(env),6M(kernel),-(rootfs)"
CONFIG_BOOTCOMMAND="run bootcmd_check_button"
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_OFFSET=0x00200000
CONFIG_ENV_SECT_SIZE=0x10000
CONFIG_DM_VIDEO=y
CONFIG_VIDEO=y
CONFIG_VIDEO_BPP8=y
CONFIG_VIDEO_BPP16=y
CONFIG_VIDEO_BPP32=y