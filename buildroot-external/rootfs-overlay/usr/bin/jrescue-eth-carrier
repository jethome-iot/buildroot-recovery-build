#!/bin/sh
#
# Is an ethernet cable plugged in?
#   exit 0 -> yes, at least one ethernet device has carrier (a live link)
#   exit 1 -> no ethernet carrier

has_carrier() {
    for d in /sys/class/net/*; do
        [ -e "$d" ] || continue
        ifn=$(basename "$d")
        [ "$ifn" = "lo" ] && continue
        [ -e "$d/wireless" ] && continue     # skip Wi-Fi
        [ -e "$d/device" ] || continue        # skip virtual (bridges, etc.)
        # carrier only reads meaningfully once the link is administratively up.
        ip link set "$ifn" up 2>/dev/null || true
        [ "$(cat "$d/carrier" 2>/dev/null)" = "1" ] && return 0
    done
    return 1
}

i=0
while [ "$i" -lt 16 ]; do
    has_carrier && exit 0
    i=$((i + 1))
    sleep 0.5
done
exit 1
