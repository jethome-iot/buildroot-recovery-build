#!/bin/bash
#
# Usage:
#   jrescue-update http://<dev-host>:8000/jrescue-app.tar.gz   # own tarball
#   jrescue-update 1.3.3                                       # GitHub release
#   jrescue-update master                                      # branch snapshot
#

set -e

src="$1"
if [ -z "$src" ]; then
    echo "usage: jrescue-update <url | version | branch>" >&2
    exit 1
fi

case "$src" in
    http://*|https://*)
        url="$src" ;;
    [0-9]*.[0-9]*)
        # looks like a version -> release asset
        url="https://github.com/jethome-iot/jrescue-app/releases/download/v${src}/jrescue-app-${src}.tar.gz" ;;
    *)
        # anything else is a branch (or tag) name -> archive snapshot
        url="https://github.com/jethome-iot/jrescue-app/archive/refs/heads/${src}.tar.gz" ;;
esac

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

echo "Downloading ${url} ..."
wget -q -O "$tmp/app.tar.gz" "$url"

mkdir -p "$tmp/x"
tar -xf "$tmp/app.tar.gz" -C "$tmp/x"

srcdir=$(find "$tmp/x" -maxdepth 1 -mindepth 1 -type d | head -n1)
[ -d "$srcdir/core" ] || { echo "no core/ inside the archive" >&2; exit 1; }

for c in core console-application oled-grid-application web-application; do
    if [ -d "$srcdir/$c" ]; then
        rm -rf "/usr/lib/jrescue-app/$c"
        cp -a "$srcdir/$c" /usr/lib/jrescue-app/
    fi
done

systemctl try-restart jrescue-web.service 2>/dev/null || true
for u in $(systemctl list-units --plain --no-legend 'jrescue-console@*' 'jrescue-oled.service' 2>/dev/null | awk '{print $1}'); do
    systemctl restart "$u" 2>/dev/null || true
done

echo "jrescue-app updated (until reboot)"
