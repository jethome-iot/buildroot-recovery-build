#!/bin/bash
#
# jrescue-update — live-patch the rescue app to a released version.
#
# Usage:
#   jrescue-update                 update to the latest GitHub release
#   jrescue-update 1.3.8           update to a specific release (leading v optional)
#   jrescue-update --list          show installed + available releases
#   jrescue-update --rollback      restore the version replaced by the last update
#   jrescue-update <branch>        dev: install a branch snapshot (APP_VERSION=dev)
#   jrescue-update http://h/x.tgz  dev: install an arbitrary tarball
#
# Only jrescue-app is swapped (pure Python in /usr/lib/jrescue-app) — the
# kernel, u-boot and base rootfs cannot be updated this way.
#
# The rescue rootfs is a RAM image, so an update lasts until the next reboot.
# To make a version permanent, bump JRESCUE_APP_VERSION in the recovery build
# (package/jrescue-app/jrescue-app.mk) and reflash the image.

set -euo pipefail

REPO="jethome-iot/jrescue-app"
TARGET="/usr/lib/jrescue-app"
PARENT="$(dirname "$TARGET")"
BACKUP="${TARGET}.prev"
COMPONENTS="core console-application oled-grid-application web-application"

log() { printf '%s\n' "$*"; }
die() { printf 'jrescue-update: %s\n' "$*" >&2; exit 1; }

current_version() {
    python3 - "$TARGET/core/config.py" <<'PY' 2>/dev/null || echo "unknown"
import re, sys
try:
    m = re.search(r'^APP_VERSION\s*=\s*["\']([^"\']+)', open(sys.argv[1]).read(), re.M)
    print(m.group(1) if m else "unknown")
except Exception:
    print("unknown")
PY
}

resolve_latest() {
    wget -q -O - "https://api.github.com/repos/$REPO/releases/latest" \
        | python3 -c 'import sys, json; print(json.load(sys.stdin)["tag_name"])' 2>/dev/null \
        || die "cannot resolve the latest release (no network?)"
}

restart_units() {
    # Running processes keep the OLD code (open by inode) until restarted, so
    # re-exec every jrescue unit. Clear failed/start-limit state first so a
    # crashed jrescue-oled starts cleanly.
    systemctl reset-failed 'jrescue-*' 2>/dev/null || true

    # web + oled are plain units; (re)start when enabled (restart also starts a
    # crashed/inactive unit). oled is only enabled on boards with a display.
    for u in jrescue-web.service jrescue-oled.service; do
        systemctl is-enabled "$u" >/dev/null 2>&1 && systemctl restart "$u" 2>/dev/null || true
    done

    # console is a TEMPLATE — restart the live instances. list-units enumerates
    # real jrescue-console@<tty> units; list-unit-files would only ever show the
    # bare @ template (which cannot be restarted), leaving the console on old code.
    for u in $(systemctl list-units --no-legend --plain --all \
                   'jrescue-console@*.service' 2>/dev/null | awk '{print $1}'); do
        case "$u" in *@.service) continue ;; esac   # never the bare template
        systemctl restart "$u" 2>/dev/null || true
    done
}

# One cleanup path for every temp/staging dir (download tmp in $TMPDIR, plus the
# swap/new dirs created under /usr/lib so the final rename stays same-filesystem).
tmp=""; new=""; swap=""
cleanup() { rm -rf ${tmp:+"$tmp"} ${new:+"$new"} ${swap:+"$swap"} 2>/dev/null || true; }
trap cleanup EXIT

# ---- --rollback --------------------------------------------------------------
if [ "${1:-}" = "--rollback" ]; then
    [ -d "$BACKUP" ] || die "no previous version to roll back to"
    if [ ! -d "$TARGET" ]; then
        # A prior update aborted mid-swap: no live tree, just promote the backup.
        mv "$BACKUP" "$TARGET"
        restart_units
        log "recovered from backup: $(current_version)"
        exit 0
    fi
    swap="$(mktemp -d "${PARENT}/.jrescue-swap.XXXXXX")"
    mv "$TARGET" "$swap/cur"    # cur    = version being rolled back from
    mv "$BACKUP" "$TARGET"      # live   = previous version
    mv "$swap/cur" "$BACKUP"    # backup = rolled-back-from (roll forward again)
    rmdir "$swap"; swap=""
    restart_units
    log "rolled back to $(current_version) (rescue rootfs is RAM — lasts until reboot)"
    exit 0
fi

# ---- --list ------------------------------------------------------------------
if [ "${1:-}" = "--list" ]; then
    log "installed: $(current_version)"
    log "available releases (newest first):"
    wget -q -O - "https://api.github.com/repos/$REPO/releases?per_page=20" \
        | python3 -c 'import sys, json
for r in json.load(sys.stdin):
    print("  " + r["tag_name"] + ("  [pre]" if r["prerelease"] else ""))' 2>/dev/null \
        || die "cannot list releases (no network?)"
    exit 0
fi

# ---- resolve the source ------------------------------------------------------
src="${1:-}"
kind="release"
case "$src" in
    "")
        tag="$(resolve_latest)"; ver="${tag#v}"
        url="https://github.com/$REPO/releases/download/$tag/jrescue-app-$ver.tar.gz" ;;
    http://*|https://*)
        kind="url"; url="$src"; ver="(tarball)" ;;
    v[0-9]*.[0-9]*|[0-9]*.[0-9]*)
        ver="${src#v}"; tag="v$ver"
        url="https://github.com/$REPO/releases/download/$tag/jrescue-app-$ver.tar.gz" ;;
    *)
        kind="branch"; ver="$src (branch)"
        url="https://github.com/$REPO/archive/refs/heads/$src.tar.gz" ;;
esac

log "current: $(current_version)"
log "target:  $ver"
log "source:  $url"

# ---- download + verify -------------------------------------------------------
tmp="$(mktemp -d)"

log "downloading ..."
wget -q -O "$tmp/app.tar.gz" "$url" || die "download failed"
[ -s "$tmp/app.tar.gz" ] || die "downloaded archive is empty"

# Release tarballs ship a .sha256 next to them — verify when both are present.
if [ "$kind" = "release" ] && command -v sha256sum >/dev/null 2>&1 \
   && wget -q -O "$tmp/app.sha256" "$url.sha256" 2>/dev/null && [ -s "$tmp/app.sha256" ]; then
    want="$(cut -d' ' -f1 "$tmp/app.sha256")"
    have="$(sha256sum "$tmp/app.tar.gz" | cut -d' ' -f1)"
    [ "$want" = "$have" ] || die "checksum mismatch (want $want, got $have) — aborting"
    log "checksum ok"
elif [ "$kind" = "release" ]; then
    log "warning: no published checksum for this release — installing unverified"
fi

# ---- stage + validate --------------------------------------------------------
mkdir -p "$tmp/x"
tar -xf "$tmp/app.tar.gz" -C "$tmp/x" || die "not a valid tarball"

srcdir="$(find "$tmp/x" -maxdepth 1 -mindepth 1 -type d | head -n1)"
[ -n "$srcdir" ] && [ -d "$srcdir/core" ] || die "archive has no core/ — not a jrescue-app tarball"

stage="$tmp/stage"; mkdir -p "$stage"
for c in $COMPONENTS; do
    [ -d "$srcdir/$c" ] || die "archive is missing component: $c"
    cp -a "$srcdir/$c" "$stage/"
done

log "validating ..."
# compileall returns 0 on a tree with NO .py files, so an empty/truncated but
# right-named archive would pass it — require real Python in each component and
# APP_VERSION in core before trusting the tree.
grep -q '^APP_VERSION' "$stage/core/config.py" 2>/dev/null \
    || die "staged core/config.py has no APP_VERSION — refusing"
for c in $COMPONENTS; do
    [ -n "$(find "$stage/$c" -name '*.py' -size +0c | head -n1)" ] \
        || die "component $c carries no Python — refusing (truncated archive?)"
done
python3 -m compileall -q "$stage" >/dev/null 2>&1 || die "new code fails to compile — not installing"

# ---- atomic swap (keep the replaced version for --rollback) ------------------
new="$(mktemp -d "${PARENT}/.jrescue-new.XXXXXX")"
cp -a "$stage/." "$new/"
rm -rf "$BACKUP"
[ -d "$TARGET" ] && mv "$TARGET" "$BACKUP"
mv "$new" "$TARGET"

restart_units

log "updated: $(current_version)  (previous kept — 'jrescue-update --rollback' to revert)"
[ "$kind" = "release" ] || log "note: dev source — APP_VERSION reads 'dev'"
log "note: rescue rootfs is a RAM image — this lasts until reboot; bump the recipe + reflash to persist"
