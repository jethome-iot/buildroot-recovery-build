[Unit]
Description=JetHub rescue console UI on %I
After=systemd-user-sessions.service recovery-slots.service
Conflicts=serial-getty@%i.service

[Service]
ExecStartPre=-/bin/sh -c 'echo 1 > /proc/sys/kernel/printk'
ExecStartPre=-/usr/bin/tty-resize
ExecStartPre=-/usr/bin/clear
ExecStart=/usr/bin/python3 /usr/lib/jrescue-app/console-application/main.py
EnvironmentFile=-/etc/machine-info
Environment=TERM=linux
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/%i
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
