#!/usr/bin/env bash

[ "$1" = "stop" ] && exit 0

echo "[net] init start"

[ -d /run ] || mkdir -p /run
[ -e /var/run ] || ln -sf /run /var/run
mkdir -p /run/wpa_supplicant

echo "[net] starting wpa_supplicant"

wpa_supplicant -i wlan0 -c /etc/wpa_supplicant.conf -C /run/wpa_supplicant -B

echo "[net] bringing up interfaces"
for iface in $(ls /sys/class/net); do
    case "$iface" in
        lo)
            echo "[net] bringing up lo"
            ip link set lo up
            ip addr add 127.0.0.1/8 dev lo 2>/dev/null || true
            ;;
        eth*|wlan*|wl*)
            echo "[net] bringing up $iface"
            ip link set "$iface" up

            for i in $(seq 1 10); do
                carrier="/sys/class/net/$iface/carrier"
                [ -f "$carrier" ] && [ "$(cat "$carrier")" = "1" ] && break
                sleep 1
            done

            echo "[net] requesting DHCP on $iface"
            udhcpc -i "$iface" -q -n -b > /dev/null 2>&1

            ip=$(ip addr show "$iface" | awk '/inet / {print $2}')
            echo "[net] $iface got IP: ${ip:-<none>}"
            ;;
    esac
done

# Time sync (BusyBox ntpd)
if pidof ntpd >/dev/null 2>&1; then
    echo "[net] ntpd already running"
else
    echo "[net] starting ntpd daemon"
    ntpd \
        -p 0.pool.ntp.org \
        -p 1.pool.ntp.org \
        -p 2.pool.ntp.org \
        >/dev/null 2>&1
fi

echo "[net] init done"
