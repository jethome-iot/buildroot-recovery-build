# /etc/inittab
#
# Copyright (C) 2001 Erik Andersen <andersen@codepoet.org>
#
# Note: BusyBox init doesn't support runlevels.  The runlevels field is
# completely ignored by BusyBox init. If you want runlevels, use
# sysvinit.
#
# Format for each entry: <id>:<runlevels>:<action>:<process>
#
# id        == tty to run on, or empty for /dev/console
# runlevels == ignored
# action    == one of sysinit, respawn, askfirst, wait, and once
# process   == program to run

# Startup the system
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -t tmpfs tmpfs /tmp
::sysinit:/bin/mount -t tmpfs tmpfs /var
::sysinit:/bin/mount -t tmpfs tmpfs /run
::sysinit:/bin/mount -t sysfs sysfs /sys
::sysinit:/bin/ln -sf /run /var/run
::sysinit:/bin/mkdir -p /run/wpa_supplicant
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys
::sysinit:/sbin/swapon -a
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
# now run any rc scripts
::sysinit:/etc/init.d/rcS

# Start mdev daemon for hotplug support
::sysinit:/bin/echo /sbin/mdev > /proc/sys/kernel/hotplug
::sysinit:/sbin/mdev -s
null::respawn:/sbin/mdev -df

# Auto-start all rescue applications simultaneously (commented for testing)
# Console application on serial port
#ttyAML0::respawn:/bin/sh -c 'cd /opt/jrescue-app/console-application && exec ./main.py'

# OLED application on framebuffer console
#tty1::respawn:/bin/sh -c 'cd /opt/jrescue-app/oled-grid-application && exec ./main.py'

# Web application (HTTP server on port 8124, runs in background)
#::respawn:/bin/sh -c 'cd /opt/jrescue-app/web-application && ./main.py > /tmp/web-app.log 2>&1'

# Put a getty on the serial port
ttyAML0::respawn:/sbin/getty 115200 ttyAML0 linux
tty1::respawn:/sbin/getty 115200 tty1 linux
#ttyS0::respawn:/sbin/getty -L ttyS0 115200 vt100 # GENERIC_SERIAL

# Stuff to do for the 3-finger salute
::ctrlaltdel:/sbin/reboot

# Stuff to do before rebooting
::shutdown:/etc/init.d/rcK
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r