From 20664141193a5dafb87a936d5bc0b54cfbc23df2 Mon Sep 17 00:00:00 2001
From: Nikita Maslo <nikitamalco203@gmail.com>
Date: Mon, 4 Aug 2025 10:12:47 +0300
Subject: [PATCH] add uboot script rescue

---
 include/configs/jethub.h | 64 ++++++++++++++++++++++++++++++++++++----
 1 file changed, 59 insertions(+), 5 deletions(-)

diff --git a/include/configs/jethub.h b/include/configs/jethub.h
index 699b2c3c899..8a53cedf14d 100644
--- a/include/configs/jethub.h
+++ b/include/configs/jethub.h
@@ -19,11 +19,65 @@
 #elif defined(CONFIG_MESON_G12A)
 #define BOOTENV_DEV_RESCUE(devtypeu, devtypel, instance) \
 	"bootcmd_rescue=" \
-		"if gpio input aobus-banks10; then " \
-		"run bootcmd_mmc1; " \
-		"run bootcmd_mmc0; " \
-		"run bootcmd_usb0;" \
-		"fi;\0"
+	"echo \"Rescue button pressed, checking for rescue.img.gz...\"; " \
+    "usb reset; " \
+    "mmc dev 1; " \
+    "setenv loadaddr 0x48000000; " \
+    "if test -e usb 0:1 rescue.img.gz; then " \
+        "echo \"Found rescue.img.gz, starting flash...\"; " \
+        "run rescue_flash; " \
+		"echo \"Flashing done. Booting from eMMC\"; " \
+        "reset; " \
+    "else " \
+        "echo \"Error: rescue.img.gz not found. Reseting...\"; " \
+        "reset; " \
+    "fi; \0"
+	\
+	"rescue_flash=" \
+    "echo \"Flashing rescue.img.gz to eMMC...\"; " \
+    "if load usb 0:1 ${loadaddr} rescue.img.gz; then " \
+        "setexpr imgsize ${filesize}; " \
+        "gzwrite mmc 1 ${loadaddr} ${imgsize}; " \
+        "echo \"Flashing complete.\"; " \
+    "else " \
+        "echo \"Failed to load rescue.img.gz!\"; " \
+        "reset; " \
+    "fi\0" \
+	\
+	"boot_script=" \
+		"sf probe;" \
+		"setenv bootargs_root \"root=/dev/mtdblock4 ro rootwait rootfs=erofs\"; " \
+		"setenv bootargs_console \"console=tty0 console=ttyAML0,115200n8 fbcon=map:1\"; " \
+		"setenv bootargs_mtdparts \"mtdparts=spi0.0:2M(uboot),64k(env),6M(kernel),-(rootfs) mtdids=nor0=spi0.0\"; " \
+		"setenv bootargs \"${bootargs_console} ${bootargs_root} ${bootargs_mtdparts}\"; " \
+		"echo \"Loading LZMA-compressed kernel from spi\"; " \
+		"if sf read 0x10000000 0x00210000 0x00600000; then " \
+			"echo \"Image.lzma loaded successfully.\"; " \
+			"if lzmadec 0x10000000 ${kernel_addr_r}; then " \
+				"echo \"LZMA decompression successful.\"; " \
+			"else " \
+				"echo \"Error: LZMA decompression failed!\"; " \
+				"reset;" \
+			"fi; " \
+		"else " \
+			"echo \"Error: Failed to load Image.lzma from SPI!\"; " \
+			"reset;" \
+		"fi; " \
+		"printenv bootargs;" \
+		"echo \"Starting kernel\"; " \
+		"fdt addr ${fdtcontroladdr}; " \
+		"booti ${kernel_addr_r} - ${fdtcontroladdr}; " \
+		"echo \"Boot failed, resetting...\"; " \
+	"reset\0" \
+	\
+	"bootcmd_check_button=" \
+    "gpio input periphs-banks70; " \
+    "setenv button_state $?; " \
+    "if test ${button_state} -eq 0; then " \
+        "run bootcmd_rescue; " \
+    "else " \
+        "run boot_script; " \
+    "fi\0"
 #else
 #define BOOTENV_DEV_RESCUE(devtypeu, devtypel, instance) \
 	"bootcmd_rescue=" \
-- 
2.43.0

