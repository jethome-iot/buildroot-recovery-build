From 6c643a894f58457daf1615026db29b38b835f255 Mon Sep 17 00:00:00 2001
From: Nikita Maslo <nikitamalco203@gmail.com>
Date: Mon, 2 Jun 2025 16:09:47 +0300
Subject: [PATCH] add usb image rescue

---
 include/configs/jethub.h | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/include/configs/jethub.h b/include/configs/jethub.h
index 699b2c3c899..e5e49d468a7 100644
--- a/include/configs/jethub.h
+++ b/include/configs/jethub.h
@@ -28,6 +28,17 @@
 #define BOOTENV_DEV_RESCUE(devtypeu, devtypel, instance) \
 	"bootcmd_rescue=" \
 		"if test \"${userbutton}\" = \"true\"; then " \
+		"if test \"${userbutton}\" = \"true\"; then " \
++		"echo \"Initializing USB...\"; " \
++		"usb reset; " \
++		"if test -e usb 0:1 rescue.img; then " \
++		"echo \"Rescue image found, starting recovery...\"; " \
++		"load usb 0:1 ${loadaddr} rescue.img; " \
++		"mmc write ${loadaddr} 0x30000 0x4000; " \
++		"reset; " \
++		"else " \
++		"echo \"No rescue image found, booting normally...\"; " \
+		"fi; " \
 		"run bootcmd_mmc0; " \
 		"fi;\0"
 #endif
-- 
