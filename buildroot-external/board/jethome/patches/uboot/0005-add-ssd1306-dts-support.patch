From 736a608ce323ca0b4378e67497d557be681c94e9 Mon Sep 17 00:00:00 2001
From: Nikita Maslo <nikitamalco203@gmail.com>
Date: Fri, 27 Jun 2025 17:27:08 +0300
Subject: [PATCH] add ssd1306 dts support

---
 arch/arm/dts/meson-sm1-jethome-jethub-j200.dts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm/dts/meson-sm1-jethome-jethub-j200.dts b/arch/arm/dts/meson-sm1-jethome-jethub-j200.dts
index 1d8f3a1dfa9..0b7766c762a 100644
--- a/arch/arm/dts/meson-sm1-jethome-jethub-j200.dts
+++ b/arch/arm/dts/meson-sm1-jethome-jethub-j200.dts
@@ -562,6 +562,14 @@
 	status = "okay";
 	pinctrl-0 = <&i2c2_sda_x_pins>, <&i2c2_sck_x_pins>;
 	pinctrl-names = "default";
+
+	ssd1306: oled@3c {
+		compatible = "solomon,ssd1306";
+		reg = <0x3c>;
+		solomon,height = <64>;
+		solomon,width = <128>;
+		solomon,segment-no-remap;
+	};
 };
 
 /* I2C_EE_M3: I2C for CPU board */
-- 
