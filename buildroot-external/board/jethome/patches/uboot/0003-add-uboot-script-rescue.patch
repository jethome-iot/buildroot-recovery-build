From 0b31498192cec4e31c2c414083ab6be1dab7aa73 Mon Sep 17 00:00:00 2001
From: Nikita Maslo <nikitamalco203@gmail.com>
Date: Wed, 18 Jun 2025 18:28:27 +0300
Subject: [PATCH] add uboot script rescue

---
 include/config_distro_bootcmd.h | 32 ++++++++++++++++++++++++++++++++
 include/configs/jethub.h        | 26 +++++++++++++++++++++-----
 2 files changed, 53 insertions(+), 5 deletions(-)

diff --git a/include/config_distro_bootcmd.h b/include/config_distro_bootcmd.h
index 0a4e4b8ff85..e6f04cfa452 100644
--- a/include/config_distro_bootcmd.h
+++ b/include/config_distro_bootcmd.h
@@ -509,6 +509,38 @@
 			"run boot_extlinux; "                             \
 			"echo EXTLINUX FAILED: continuing...; "           \
 		"fi\0"                                                    \
+	"boot_scrpit=" \
+		"sf probe;" \
+		"setenv bootargs_root \"root=/dev/mtdblock4 ro rootwait rootfs=erofs\"; " \
+		"setenv bootargs_console \"console=tty0 console=ttyAML0,115200n8\"; " \
+		"setenv bootargs_mtdparts \"mtdparts=spi0.0:2M(uboot),64k(env),7M(kernel),-(rootfs) mtdids=nor0=spi0.0\"; " \
+		"setenv bootargs_root \"${bootargs_console} ${bootargs_root} ${bootargs_mtdparts}\"; " \
+		"echo \"Loading LZMA-compressed kernel from mmc\"; " \
+		"if sf read 0x10000000 0x00210000 0x00600000; then " \
+			"echo \"Image.lzma loaded successfully.\"; " \
+			"if lzmadec 0x10000000 ${kernel_addr_r}; then " \
+				"echo \"LZMA decompression successful.\"; " \
+			"else " \
+				"echo \"Error: LZMA decompression failed!\"; " \
+				"reset;" \
+			"fi; " \
+		"else " \
+			"echo \"Error: Failed to load Image.lzma from SPI!\"; " \
+			"reset;" \
+		"fi; " \
+		"printenv bootargs;" \
+		"echo \"Starting kernel\"; " \
+		"fdt addr ${fdtcontroladdr}; " \
+		"booti ${kernel_addr_r} - ${fdtcontroladdr}; " \
+		"echo \"Boot failed, resetting...\"; " \
+		"reset\0" \
+		\
+	"bootcmd_check_button=" \
+		"if gpio input aobus-banks10; then " \
+		"run bootcmd_rescue; " \
+		"else " \
+		"run boot_script; "	\
+		"fi\0" \
 	\
 	"boot_a_script="                                                  \
 		"load ${devtype} ${devnum}:${distro_bootpart} "           \
diff --git a/include/configs/jethub.h b/include/configs/jethub.h
index 699b2c3c899..70b5ef0c9ec 100644
--- a/include/configs/jethub.h
+++ b/include/configs/jethub.h
@@ -19,11 +19,27 @@
 #elif defined(CONFIG_MESON_G12A)
 #define BOOTENV_DEV_RESCUE(devtypeu, devtypel, instance) \
 	"bootcmd_rescue=" \
-		"if gpio input aobus-banks10; then " \
-		"run bootcmd_mmc1; " \
-		"run bootcmd_mmc0; " \
-		"run bootcmd_usb0;" \
-		"fi;\0"
+    "if gpio input aobus-banks10; then " \
+        "echo \"Rescue button pressed, starting recovery...\"; " \
+        "usb reset; " \
+        "mmc dev 1; " \
+        "setenv mmcblkstart 0; " \
+		"setenv chunkfiles 'aa ab ac'; " \
+        "setenv chunkblocks 0x1000000; " \
+        "for part in ${chunkfiles}; do " \
+            "echo \"Loading rescue.img.part.${part}...\"; " \
+            "load usb 0:1 ${loadaddr} rescue.img.part.${part}; " \
+            "mmc write ${loadaddr} ${mmcblkstart} ${chunkblocks}; " \
+            "setexpr mmcblkstart ${mmcblkstart} + ${chunkblocks}; " \
+        "done; " \
+        "echo \"Loading final chunk (rescue.img.part.ad)...\"; " \
+        "load usb 0:1 ${loadaddr} rescue.img.part.ad; " \
+        "setexpr lastblocks ${filesize} / 512; " \
+        "mmc write ${loadaddr} ${mmcblkstart} ${lastblocks}; " \
+        "echo \"Flashing complete. Rebooting...\"; " \
+        "reset; " \
+    "fi;\0"
+
 #else
 #define BOOTENV_DEV_RESCUE(devtypeu, devtypel, instance) \
 	"bootcmd_rescue=" \
-- 
2.43.0

