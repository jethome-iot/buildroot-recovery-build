From 72c6cc20569f8e45ea0db73ae7b8458fef7f885b Mon Sep 17 00:00:00 2001
From: Nikita Maslo <nikitamalco203@gmail.com>
Date: Fri, 24 Apr 2026 12:26:25 +0300
Subject: [PATCH] Add eMMC write protect cmd command for special areas for WP
 groups

---
 cmd/Kconfig                  |  12 +++
 cmd/mmc.c                    | 153 ++++++++++++++++++++++++++++++++-
 configs/jethub_j80_defconfig |   2 +
 drivers/mmc/mmc.c            | 128 ++++++++++++++++++++++++
 include/mmc.h                |  47 +++++++++
 5 files changed, 341 insertions(+), 1 deletion(-)

diff --git a/cmd/Kconfig b/cmd/Kconfig
index 322ebe600c5..bd740cb96c0 100644
--- a/cmd/Kconfig
+++ b/cmd/Kconfig
@@ -1500,6 +1500,18 @@ config CMD_MMC_SWRITE
 	  Enable support for the "mmc swrite" command to write Android sparse
 	  images to eMMC.
 
+config CMD_MMC_USER_WP
+	bool "mmc wp user -- user-area write protection"
+	depends on CMD_MMC
+	select MMC_HW_PARTITIONING
+	help
+	  Enable "mmc wp user {info|set|status}" subcommands for managing
+	  power-on write protection of the user data area on eMMC (CMD28 /
+	  CMD31 and EXT_CSD[171] USER_WP). Protection is aligned to the
+	  HC_WP_GRP_SIZE boundary and is cleared by a full power cycle, which
+	  is useful for defending a second image during development without
+	  the risk of permanent write protection.
+
 config MMC_SPEED_MODE_SET
 	bool "set speed mode using mmc command"
 	help
diff --git a/cmd/mmc.c b/cmd/mmc.c
index 6cb1ef5dc23..824c5b99221 100644
--- a/cmd/mmc.c
+++ b/cmd/mmc.c
@@ -1122,6 +1122,136 @@ static int do_mmc_bkops_enable(struct cmd_tbl *cmdtp, int flag,
 }
 #endif
 
+#if CONFIG_IS_ENABLED(CMD_MMC_USER_WP)
+static const char * const wp_type_names[] = {
+	[MMC_WP_TYPE_NONE] = "none",
+	[MMC_WP_TYPE_TEMP] = "temporary",
+	[MMC_WP_TYPE_PWR]  = "power-on",
+	[MMC_WP_TYPE_PERM] = "permanent",
+};
+
+static int do_mmc_user_wp_info(struct mmc *mmc)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(u8, ext_csd, MMC_MAX_BLOCK_LEN);
+	lbaint_t user_blocks;
+	u8 user_wp;
+	int ret;
+
+	if (!mmc->hc_wp_grp_size) {
+		printf("WP groups not supported by this device\n");
+		return CMD_RET_FAILURE;
+	}
+
+	ret = mmc_send_ext_csd(mmc, ext_csd);
+	if (ret) {
+		printf("Could not read EXT_CSD: %d\n", ret);
+		return CMD_RET_FAILURE;
+	}
+	user_wp = ext_csd[EXT_CSD_USER_WP];
+	user_blocks = mmc->capacity_user >> 9;
+
+	printf("WP group size: 0x" LBAF " blocks (",
+	       (lbaint_t)mmc->hc_wp_grp_size);
+	print_size((u64)mmc->hc_wp_grp_size << 9, ")\n");
+	printf("User area:     0x" LBAF " blocks (", user_blocks);
+	print_size((u64)user_blocks << 9, ", ");
+	printf(LBAFU " groups)\n", user_blocks / mmc->hc_wp_grp_size);
+	printf("USER_WP:       0x%02x\n", user_wp);
+	printf("Power-on WP:   %s, %s\n",
+	       (user_wp & EXT_CSD_USER_WP_US_PWR_WP_EN) ? "armed" : "disarmed",
+	       (user_wp & EXT_CSD_USER_WP_US_PWR_WP_DIS) ? "locked" : "armable");
+	printf("Permanent WP:  %s, %s\n",
+	       (user_wp & EXT_CSD_USER_WP_US_PERM_WP_EN) ? "ARMED" : "disarmed",
+	       (user_wp & EXT_CSD_USER_WP_US_PERM_WP_DIS) ? "locked" : "armable");
+
+	if (user_wp & EXT_CSD_USER_WP_US_PERM_WP_EN)
+		printf("Warning: permanent WP armed, 'wp user set' is irreversible\n");
+
+	return CMD_RET_SUCCESS;
+}
+
+static int do_mmc_user_wp_set(struct mmc *mmc, int argc, char *const argv[])
+{
+	lbaint_t start, count, aligned_start, aligned_count;
+	int ret;
+
+	/* argv: [0]="wp" [1]="user" [2]="set" [3]=start [4]=count */
+	if (argc != 5)
+		return CMD_RET_USAGE;
+
+	start = hextoul(argv[3], NULL);
+	count = hextoul(argv[4], NULL);
+
+	ret = mmc_user_wp_set_range(mmc, start, count,
+				    &aligned_start, &aligned_count);
+	switch (ret) {
+	case 0:
+		break;
+	case -ENOTSUPP:
+		printf("WP groups not supported by this device\n");
+		return CMD_RET_FAILURE;
+	case -EACCES:
+		printf("Refused: US_PERM_WP_EN set, CMD28 would protect permanently\n");
+		return CMD_RET_FAILURE;
+	case -EPERM:
+		printf("Refused: power-on WP locked (US_PWR_WP_DIS), power-cycle first\n");
+		return CMD_RET_FAILURE;
+	default:
+		printf("WP set failed: %d\n", ret);
+		return CMD_RET_FAILURE;
+	}
+
+	printf("Protected 0x" LBAF "-0x" LBAF " (", aligned_start,
+	       aligned_start + aligned_count - 1);
+	print_size((u64)aligned_count << 9, "), cleared on power cycle\n");
+	return CMD_RET_SUCCESS;
+}
+
+static int do_mmc_user_wp_status(struct mmc *mmc, int argc,
+				 char *const argv[])
+{
+	lbaint_t start, base, grp = mmc->hc_wp_grp_size;
+	int i, run, ret;
+	u64 type;
+
+	/* argv: [0]="wp" [1]="user" [2]="status" [3]=start (optional) */
+	if (argc > 4)
+		return CMD_RET_USAGE;
+
+	if (!grp) {
+		printf("WP groups not supported by this device\n");
+		return CMD_RET_FAILURE;
+	}
+
+	start = (argc == 4) ? hextoul(argv[3], NULL) : 0;
+	base = (start / grp) * grp;
+
+	ret = mmc_user_wp_get_type(mmc, start, &type);
+	if (ret) {
+		printf("Could not read WP type: %d\n", ret);
+		return CMD_RET_FAILURE;
+	}
+
+	printf("WP type from 0x" LBAF ", 32 groups (", base);
+	print_size((u64)grp * 32 << 9, ")\n");
+
+	/* collapse consecutive groups sharing the same WP type into one line */
+	for (run = 0, i = 1; i <= 32; i++) {
+		unsigned int t = (type >> (2 * run)) & 0x3;
+
+		if (i < 32 && ((type >> (2 * i)) & 0x3) == t)
+			continue;
+		printf("  0x" LBAF "-0x" LBAF "  %s\n",
+		       base + (lbaint_t)run * grp,
+		       base + (lbaint_t)i * grp - 1, wp_type_names[t]);
+		run = i;
+	}
+
+	printf("next: mmc wp user status 0x" LBAF "\n", base + 32 * grp);
+	return CMD_RET_SUCCESS;
+}
+#endif /* CMD_MMC_USER_WP */
+
 static int do_mmc_boot_wp(struct cmd_tbl *cmdtp, int flag,
 			  int argc, char * const argv[])
 {
@@ -1137,6 +1267,20 @@ static int do_mmc_boot_wp(struct cmd_tbl *cmdtp, int flag,
 		return CMD_RET_FAILURE;
 	}
 
+#if CONFIG_IS_ENABLED(CMD_MMC_USER_WP)
+	if (argc >= 2 && !strcmp(argv[1], "user")) {
+		if (argc < 3)
+			return CMD_RET_USAGE;
+		if (!strcmp(argv[2], "info"))
+			return do_mmc_user_wp_info(mmc);
+		if (!strcmp(argv[2], "set"))
+			return do_mmc_user_wp_set(mmc, argc, argv);
+		if (!strcmp(argv[2], "status"))
+			return do_mmc_user_wp_status(mmc, argc, argv);
+		return CMD_RET_USAGE;
+	}
+#endif
+
 	if (argc == 2) {
 		part = dectoul(argv[1], NULL);
 		err = mmc_boot_wp_single_partition(mmc, part);
@@ -1240,7 +1384,7 @@ static int do_mmc_reg(struct cmd_tbl *cmdtp, int flag,
 static struct cmd_tbl cmd_mmc[] = {
 	U_BOOT_CMD_MKENT(info, 1, 0, do_mmcinfo, "", ""),
 	U_BOOT_CMD_MKENT(read, 4, 1, do_mmc_read, "", ""),
-	U_BOOT_CMD_MKENT(wp, 2, 0, do_mmc_boot_wp, "", ""),
+	U_BOOT_CMD_MKENT(wp, 5, 0, do_mmc_boot_wp, "", ""),
 #if CONFIG_IS_ENABLED(MMC_WRITE)
 	U_BOOT_CMD_MKENT(write, 4, 0, do_mmc_write, "", ""),
 	U_BOOT_CMD_MKENT(erase, 3, 0, do_mmc_erase, "", ""),
@@ -1324,6 +1468,13 @@ U_BOOT_CMD(
 	"   PART - [0|1]\n"
 	"       : 0 - first boot partition, 1 - second boot partition\n"
 	"         if not assigned, write protect all boot partitions\n"
+#if CONFIG_IS_ENABLED(CMD_MMC_USER_WP)
+	"mmc wp user info - show user area write protect state\n"
+	"mmc wp user set <blk#> <cnt> - power-on write protect a block range\n"
+	"   : range is grown outward to WP group boundaries\n"
+	"     protection clears on power cycle, not on 'reset'\n"
+	"mmc wp user status [blk#] - show WP type of 32 groups from blk#\n"
+#endif
 #if CONFIG_IS_ENABLED(MMC_HW_PARTITIONING)
 	"mmc hwpartition <USER> <GP> <MODE> - does hardware partitioning\n"
 	"  arguments (sizes in 512-byte blocks):\n"
diff --git a/configs/jethub_j80_defconfig b/configs/jethub_j80_defconfig
index b5cc58a17be..f14d47d3e22 100644
--- a/configs/jethub_j80_defconfig
+++ b/configs/jethub_j80_defconfig
@@ -35,6 +35,8 @@ CONFIG_CMD_GPIO=y
 CONFIG_CMD_I2C=y
 # CONFIG_CMD_LOADS is not set
 CONFIG_CMD_MMC=y
+CONFIG_CMD_MMC_REG=y
+CONFIG_CMD_MMC_USER_WP=y
 CONFIG_CMD_USB=y
 CONFIG_CMD_USB_MASS_STORAGE=y
 CONFIG_CMD_RTC=y
diff --git a/drivers/mmc/mmc.c b/drivers/mmc/mmc.c
index c5705f4f215..872f77a09d5 100644
--- a/drivers/mmc/mmc.c
+++ b/drivers/mmc/mmc.c
@@ -960,6 +960,134 @@ int mmc_boot_wp_single_partition(struct mmc *mmc, int partition)
 	return ret;
 }
 
+int mmc_user_wp_set_range(struct mmc *mmc, lbaint_t start_blk,
+			  lbaint_t count_blk, lbaint_t *aligned_start,
+			  lbaint_t *aligned_count)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(u8, ext_csd, MMC_MAX_BLOCK_LEN);
+	struct mmc_cmd cmd = {};
+	lbaint_t grp, end, addr;
+	u8 user_wp;
+	int ret;
+
+	if (IS_SD(mmc) || mmc->version < MMC_VERSION_4_41)
+		return -ENOTSUPP;
+	if (!mmc->hc_wp_grp_size)
+		return -ENOTSUPP;
+	if (!count_blk)
+		return -EINVAL;
+	if (start_blk >= mmc->capacity_user >> 9)
+		return -ERANGE;
+
+	grp = mmc->hc_wp_grp_size;
+	/* Align outward: [start_blk, start_blk+count_blk) -> WP-group bounds */
+	end = ((start_blk + count_blk + grp - 1) / grp) * grp;
+	start_blk = (start_blk / grp) * grp;
+	if (end > mmc->capacity_user >> 9)
+		end = mmc->capacity_user >> 9;
+	if (end <= start_blk)
+		return -ERANGE;
+	count_blk = end - start_blk;
+
+	ret = mmc_send_ext_csd(mmc, ext_csd);
+	if (ret)
+		return ret;
+	user_wp = ext_csd[EXT_CSD_USER_WP];
+	/*
+	 * Refuse if permanent-WP enable is already latched: any CMD28 we issue
+	 * would make the affected WP-groups permanently read-only. This code
+	 * never wants to be responsible for an irreversible change -- the user
+	 * must clear the bit out-of-band first (or power-cycle, since this bit
+	 * is cleared on power-on).
+	 */
+	if (user_wp & EXT_CSD_USER_WP_US_PERM_WP_EN)
+		return -EACCES;
+	/*
+	 * If US_PWR_WP_DIS is set, the host cannot enable power-on WP until
+	 * the next power cycle. Bail out early with a clear error.
+	 */
+	if (user_wp & EXT_CSD_USER_WP_US_PWR_WP_DIS)
+		return -EPERM;
+
+	ret = mmc_switch(mmc, EXT_CSD_CMD_SET_NORMAL, EXT_CSD_USER_WP,
+			 (user_wp & ~EXT_CSD_USER_WP_US_PERM_WP_EN) |
+			 EXT_CSD_USER_WP_US_PWR_WP_EN);
+	if (ret)
+		return ret;
+
+	for (addr = start_blk; addr < end; addr += grp) {
+		cmd.cmdidx = MMC_CMD_SET_WRITE_PROT;
+		cmd.resp_type = MMC_RSP_R1b;
+		/* HC cards take block address; SC cards want bytes */
+		cmd.cmdarg = mmc->high_capacity ? addr : addr << 9;
+		ret = mmc_send_cmd(mmc, &cmd, NULL);
+		if (ret)
+			goto out_restore;
+	}
+
+out_restore:
+	/*
+	 * Always restore USER_WP so a stray CMD28 later will not latch WP.
+	 * Mask out US_PERM_WP_EN even though we refused to run when it was set
+	 * on entry -- defence in depth against any future code path that would
+	 * have left the bit armed.
+	 */
+	mmc_switch(mmc, EXT_CSD_CMD_SET_NORMAL, EXT_CSD_USER_WP,
+		   user_wp & ~EXT_CSD_USER_WP_US_PERM_WP_EN);
+
+	if (!ret) {
+		if (aligned_start)
+			*aligned_start = start_blk;
+		if (aligned_count)
+			*aligned_count = count_blk;
+	}
+	return ret;
+}
+
+int mmc_user_wp_get_type(struct mmc *mmc, lbaint_t start_blk, u64 *type)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(u8, buf, MMC_MAX_BLOCK_LEN);
+	struct mmc_cmd cmd = {};
+	struct mmc_data data = {};
+	u64 packed = 0;
+	int i, ret;
+
+	if (IS_SD(mmc) || mmc->version < MMC_VERSION_4_41)
+		return -ENOTSUPP;
+	if (!mmc->hc_wp_grp_size)
+		return -ENOTSUPP;
+	if (!type)
+		return -EINVAL;
+
+	/* CMD31 operates on the WP-group containing start_blk */
+	start_blk = (start_blk / mmc->hc_wp_grp_size) * mmc->hc_wp_grp_size;
+
+	cmd.cmdidx = MMC_CMD_SEND_WRITE_PROT_TYPE;
+	cmd.resp_type = MMC_RSP_R1;
+	cmd.cmdarg = mmc->high_capacity ? start_blk : start_blk << 9;
+
+	data.dest = (char *)buf;
+	data.blocks = 1;
+	data.blocksize = 8;
+	data.flags = MMC_DATA_READ;
+
+	ret = mmc_send_cmd(mmc, &cmd, &data);
+	if (ret)
+		return ret;
+
+	/*
+	 * Per JESD84: SEND_WRITE_PROT_TYPE returns 8 bytes, MSB first. The
+	 * lowest-address group's 2-bit type ends up in the LSBs of the packed
+	 * value, so bit (2*n) of the u64 is the type of the n-th group from
+	 * start_blk. Decode cross-checked on j310 against Linux
+	 * 'mmc writeprotect user get', which reports the same groups.
+	 */
+	for (i = 0; i < 8; i++)
+		packed = (packed << 8) | buf[i];
+	*type = packed;
+	return 0;
+}
+
 #if !CONFIG_IS_ENABLED(MMC_TINY)
 static int mmc_set_card_speed(struct mmc *mmc, enum bus_mode mode,
 			      bool hsdowngrade)
diff --git a/include/mmc.h b/include/mmc.h
index 51d3f2f8dd5..f4d03aaa17c 100644
--- a/include/mmc.h
+++ b/include/mmc.h
@@ -104,6 +104,10 @@ struct bd_info;
 #define MMC_CMD_SET_BLOCK_COUNT         23
 #define MMC_CMD_WRITE_SINGLE_BLOCK	24
 #define MMC_CMD_WRITE_MULTIPLE_BLOCK	25
+#define MMC_CMD_SET_WRITE_PROT		28
+#define MMC_CMD_CLR_WRITE_PROT		29
+#define MMC_CMD_SEND_WRITE_PROT		30
+#define MMC_CMD_SEND_WRITE_PROT_TYPE	31
 #define MMC_CMD_ERASE_GROUP_START	35
 #define MMC_CMD_ERASE_GROUP_END		36
 #define MMC_CMD_ERASE			38
@@ -309,6 +313,17 @@ static inline bool mmc_is_tuning_cmd(uint cmdidx)
 #define EXT_CSD_BOOT_WP_B_PWR_WP_SEC_SEL (0x02)	/* partition selector to protect */
 #define EXT_CSD_BOOT_WP_B_PWR_WP_EN	(0x01)	/* power-on write-protect */
 
+#define EXT_CSD_USER_WP_US_PWR_WP_EN	(0x01)	/* enable power-on WP via CMD28 */
+#define EXT_CSD_USER_WP_US_PERM_WP_EN	(0x04)	/* enable permanent WP via CMD28 */
+#define EXT_CSD_USER_WP_US_PWR_WP_DIS	(0x08)	/* disable US_PWR_WP_EN */
+#define EXT_CSD_USER_WP_US_PERM_WP_DIS	(0x10)	/* disable US_PERM_WP_EN */
+
+/* CMD31 SEND_WRITE_PROT_TYPE returns 2 bits per WP-group: */
+#define MMC_WP_TYPE_NONE	0x0
+#define MMC_WP_TYPE_TEMP	0x1
+#define MMC_WP_TYPE_PWR		0x2
+#define MMC_WP_TYPE_PERM	0x3
+
 #define EXT_CSD_WR_DATA_REL_USR		(1 << 0)	/* user data area WR_REL */
 #define EXT_CSD_WR_DATA_REL_GP(x)	(1 << ((x)+1))	/* GP part (x+1) WR_REL */
 
@@ -1057,6 +1072,38 @@ int mmc_boot_wp(struct mmc *mmc);
  */
 int mmc_boot_wp_single_partition(struct mmc *mmc, int partition);
 
+/**
+ * mmc_user_wp_set_range() - power-on write protect a user-area LBA range.
+ *
+ * The request is aligned outward to HC_WP_GRP_SIZE boundaries. The protected
+ * region persists until the next power cycle (a warm reboot may or may not
+ * clear it depending on whether the board actually removes eMMC VCC).
+ *
+ * @mmc:          the mmc device
+ * @start_blk:    first 512-byte LBA of the requested range
+ * @count_blk:    length in 512-byte blocks
+ * @aligned_start: out, first LBA that was actually protected
+ * @aligned_count: out, number of blocks that were actually protected
+ * Return: 0 on success, negative errno otherwise
+ */
+int mmc_user_wp_set_range(struct mmc *mmc, lbaint_t start_blk,
+			  lbaint_t count_blk, lbaint_t *aligned_start,
+			  lbaint_t *aligned_count);
+
+/**
+ * mmc_user_wp_get_type() - read WP type for 32 WP-groups starting at start_blk.
+ *
+ * Sends CMD31 (SEND_WRITE_PROT_TYPE). Each pair of bits in the returned 64-bit
+ * value describes one WP-group; the least-significant pair corresponds to the
+ * group containing @start_blk. Encoding: see MMC_WP_TYPE_* in this file.
+ *
+ * @mmc:       the mmc device
+ * @start_blk: 512-byte LBA inside the first WP-group to query
+ * @type:      out, 64-bit packed WP types
+ * Return: 0 on success, negative errno otherwise
+ */
+int mmc_user_wp_get_type(struct mmc *mmc, lbaint_t start_blk, u64 *type);
+
 static inline enum dma_data_direction mmc_get_dma_dir(struct mmc_data *data)
 {
 	return data->flags & MMC_DATA_WRITE ? DMA_TO_DEVICE : DMA_FROM_DEVICE;
-- 
2.43.0

