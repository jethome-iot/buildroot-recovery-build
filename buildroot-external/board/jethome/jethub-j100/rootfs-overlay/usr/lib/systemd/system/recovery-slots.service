[Unit]
Description=Create loop devices for recovery A/B raw slots
DefaultDependencies=no
After=dev-mmcblk1.device
Requires=dev-mmcblk1.device

[Service]
Type=oneshot
RemainAfterExit=yes
# Slot A at 132 MiB, slot B at 234 MiB, 102 MiB each (same layout as j310).
# eMMC is mmcblk1 on mainline: block index follows the mmc host index and
# host 0 is the SDIO wifi controller
ExecStart=/usr/sbin/losetup -o 138412032 --sizelimit 106954752 /dev/loop0 /dev/mmcblk1
ExecStart=/usr/sbin/losetup -o 245366784 --sizelimit 106954752 /dev/loop1 /dev/mmcblk1
ExecStop=/usr/sbin/losetup -d /dev/loop0
ExecStop=/usr/sbin/losetup -d /dev/loop1

[Install]
WantedBy=multi-user.target
