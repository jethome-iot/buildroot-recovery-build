# Persist the environment (recovery_slot) in eMMC, readable by fw_printenv:
# raw offset 3.5 MiB inside the u-boot area, 64 KiB (matches fw_env.config
# generated from this board's meta)
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_OFFSET=0x380000
CONFIG_ENV_MMC_DEVICE_INDEX=1

CONFIG_CMD_MMC_REG=y
CONFIG_CMD_MMC_USER_WP=y

# CONFIG_EFI_LOADER is not set
# CONFIG_TOOLS_MKEFICAPSULE is not set
