# Recovery fragment on top of kernel-mainline.config for JetHub J100 (A113X/AXG).
# The initramfs ships no kernel modules, so everything the recovery needs
# must be built in.

# Ethernet: AXG dwmac glue and external ICPlus IP101A/G PHY are =m in the base config
CONFIG_DWMAC_MESON=y
CONFIG_ICPLUS_PHY=y

# WiFi: JetHub D1/D1+ ships two SDIO module variants depending on board
# revision, so build both drivers into the single recovery image:
#   D1  (j100):  Broadcom AP6255/AP6256 (BCM43455/43456) -> brcmfmac (fullmac,
#                cfg80211 only), binds via Broadcom SDIO IDs
#   D1+ (j110):  Realtek RTL8822CS                        -> rtw88 (mac80211),
#                binds via Realtek SDIO ID (needs no DT wifi node)
# Both bind by SDIO vendor/device id, so the baked-in j100 DTB (which carries a
# brcm wifi child node) is harmless for the Realtek card.
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=y
CONFIG_RTW88_8822CS=y

# Board peripherals
CONFIG_MESON_GXBB_WATCHDOG=y
CONFIG_RTC_DRV_PCF8563=y
CONFIG_EEPROM_AT24=y
CONFIG_NVMEM_MESON_EFUSE=y
CONFIG_HW_RANDOM_MESON=y
CONFIG_MESON_SARADC=y

# Filesystems on target disks
CONFIG_MSDOS_FS=y
# vfat refuses to mount when the default iocharset (iso8859-1) NLS table
# cannot be loaded; base config has these =m and we ship no modules
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Reboot automatically if the recovery kernel panics
CONFIG_PANIC_TIMEOUT=5

CONFIG_CMDLINE="rtw88_core.disable_lps_deep=1 quiet systemd.show_status=false"
