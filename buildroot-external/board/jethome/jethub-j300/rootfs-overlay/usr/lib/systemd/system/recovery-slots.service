[Unit]
Description=Create loop devices for recovery A/B raw slots
DefaultDependencies=no
After=dev-mmcblk1.device
Requires=dev-mmcblk1.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/losetup -o 4194304 --sizelimit 104857600 /dev/loop0 /dev/mmcblk1
ExecStart=/usr/sbin/losetup -o 109051904 --sizelimit 104857600 /dev/loop1 /dev/mmcblk1
ExecStop=/usr/sbin/losetup -d /dev/loop0
ExecStop=/usr/sbin/losetup -d /dev/loop1

[Install]
WantedBy=multi-user.target
