From 3720c650a2cf094a9887c62c855f44668e0c73c5 Mon Sep 17 00:00:00 2001
From: Nikita Maslo <nikitamalco203@gmail.com>
Date: Tue, 8 Apr 2025 16:50:28 +0300
Subject: [PATCH] test uboot script

---
 configs/jethub_j80_defconfig    |  1 +
 include/config_distro_bootcmd.h |  7 +++++++
 include/configs/jethub.h        | 12 +++++++++++-
 3 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/configs/jethub_j80_defconfig b/configs/jethub_j80_defconfig
index 570a9d632e6..a6b7005fe88 100644
--- a/configs/jethub_j80_defconfig
+++ b/configs/jethub_j80_defconfig
@@ -85,3 +85,4 @@ CONFIG_SECURE_STORAGE=y
 CONFIG_AML_STORAGE=y
 CONFIG_EFUSE=y
 CONFIG_AML_PARTITION=y
+CONFIG_BOOTCOMMAND="run bootcmd_check_button"
\ No newline at end of file
diff --git a/include/config_distro_bootcmd.h b/include/config_distro_bootcmd.h
index 43cd228be05..9ad2ca6865b 100644
--- a/include/config_distro_bootcmd.h
+++ b/include/config_distro_bootcmd.h
@@ -581,6 +581,13 @@
 		"echo \"Boot failed, resetting...\"; " \
 		"reset;\0"	\
 	\
+	"bootcmd_check_button="	\
+		"if test \"${userbutton}\" = \"true\"; then "\
+		"run bootcmd_rescue; " \
+		"else " \
+		"run boot_script; "	\
+		"fi;\0" \
+	\
 	"boot_a_script="                                                  \
 		"load ${devtype} ${devnum}:${distro_bootpart} "           \
 			"${scriptaddr} ${prefix}${script}; "              \
diff --git a/include/configs/jethub.h b/include/configs/jethub.h
index 9e16cfcf199..a8d8a423c69 100644
--- a/include/configs/jethub.h
+++ b/include/configs/jethub.h
@@ -20,8 +20,18 @@
 #else
 #define BOOTENV_DEV_RESCUE(devtypeu, devtypel, instance) \
 	"bootcmd_rescue=" \
+		"if test \"${userbutton}\" = \"true\"; then " \
+		"echo \"Initializing USB...\"; " \
+		"usb reset; " \
+		"if test -e usb 0:1 rescue.img; then " \
+		"echo \"Rescue image found, starting recovery...\"; " \
+		"load usb 0:1 ${loadaddr} rescue.img; " \
+		"mmc write ${loadaddr} 0x30000 0x4000; " \
+		"reset; " \
+		"else " \
+		"echo \"No rescue image found, booting normally...\"; " \
 		"run boot_script; " \
-		"run bootcmd_mmc0; " \
+		"fi; " \
 		"fi;\0"
 #endif
 
-- 
2.43.0

