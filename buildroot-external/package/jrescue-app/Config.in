config BR2_PACKAGE_JRESCUE_APP
	bool "jrescue-app"
	depends on BR2_USE_WCHAR
	depends on BR2_USE_MMU
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HEADERS_AT_LEAST_4_4
	select BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON3_CURSES
	select BR2_PACKAGE_NCURSES
	select BR2_PACKAGE_NCURSES_WCHAR
	select BR2_PACKAGE_PYTHON3_SSL
	select BR2_PACKAGE_PYTHON3_XZ
	select BR2_PACKAGE_PYTHON3_ZLIB
	select BR2_PACKAGE_PV
	select BR2_PACKAGE_PYTHON_PILLOW
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_DEJAVU
	select BR2_PACKAGE_PYTHON_EVDEV
	select BR2_PACKAGE_HOSTAPD
	select BR2_PACKAGE_HOSTAPD_DRIVER_NL80211
	select BR2_PACKAGE_DNSMASQ
	select BR2_PACKAGE_IW
	select BR2_PACKAGE_UTIL_LINUX_RFKILL
	select BR2_PACKAGE_AVAHI
	select BR2_PACKAGE_AVAHI_DAEMON
	help
	  JetHome rescue application: console, OLED, and web
	  interfaces for eMMC firmware flashing on JetHub devices.

	  Networking is driven through NetworkManager (nmcli), which
	  is a system-level choice and is NOT selected here — enable
	  BR2_PACKAGE_NETWORK_MANAGER(_CLI) in the defconfig.

	  https://github.com/jethome-iot/jrescue-app

comment "jrescue-app needs a toolchain w/ wchar, threads, C++, dynamic library, headers >= 4.4"
	depends on BR2_USE_MMU
	depends on !BR2_USE_WCHAR || !BR2_TOOLCHAIN_HAS_THREADS || \
		BR2_STATIC_LIBS || !BR2_INSTALL_LIBSTDCPP || \
		!BR2_TOOLCHAIN_HEADERS_AT_LEAST_4_4
